// ═══════════════════════════════════════════════════════════════
//  FABLE AI — Plantillas Pine Script v5 (TradingView)
//  Estrategias base espejo del backtest engine Python:
//  trend (MA cross) · mean_reversion (RSI) · breakout (Donchian)
//  Úsalas como punto de partida para que Claude las adapte
//  vía MCP (get_candles -> run_backtest -> iteración de prompts).
// ═══════════════════════════════════════════════════════════════

//@version=5
strategy("FABLE Trend MA Cross", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=2, pyramiding=0)

// ── inputs ──
fastLen = input.int(20,  "Fast MA")
slowLen = input.int(50,  "Slow MA")
useShort = input.bool(true, "Permitir SHORT")

// ── señales ──
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)

longCond  = ta.crossover(fast, slow)
shortCond = ta.crossunder(fast, slow)

if longCond
    strategy.entry("L", strategy.long)
if shortCond and useShort
    strategy.entry("S", strategy.short)

// ── visual ──
plot(fast, "Fast", color=color.new(color.aqua, 0))
plot(slow, "Slow", color=color.new(color.orange, 0))
bgcolor(longCond ? color.new(color.green, 85) : na)
bgcolor(shortCond ? color.new(color.red, 85) : na)


//@version=5
strategy("FABLE Mean Reversion RSI", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=2, pyramiding=0)

rsiLen   = input.int(14, "RSI Length")
buyLevel = input.float(30, "Buy (oversold)")
sellLevel = input.float(70, "Sell (overbought)")

r = ta.rsi(close, rsiLen)

if ta.crossunder(r, buyLevel)
    strategy.entry("L", strategy.long)
if ta.crossover(r, sellLevel)
    strategy.entry("S", strategy.short)
if ta.cross(r, 50)
    strategy.close_all()

plot(r, "RSI", color=color.new(color.purple, 0))
hline(buyLevel,  "Oversold", color=color.new(color.green, 40))
hline(sellLevel, "Overbought", color=color.new(color.red, 40))


//@version=5
strategy("FABLE Breakout Donchian", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=2, pyramiding=0)

lookback = input.int(20, "Donchian Lookback")
useShort = input.bool(true, "Permitir SHORT")

hi = ta.highest(high, lookback)[1]
lo = ta.lowest(low, lookback)[1]

longCond  = ta.crossover(close, hi)
shortCond = ta.crossunder(close, lo)

if longCond
    strategy.entry("L", strategy.long)
if shortCond and useShort
    strategy.entry("S", strategy.short)

plot(hi, "Upper", color=color.new(color.green, 0))
plot(lo, "Lower", color=color.new(color.red, 0))
